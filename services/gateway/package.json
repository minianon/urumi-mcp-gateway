{
  "name": "@urumi/gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Team MCP gateway: dashboard API, aggregated MCP endpoint, upstream MCP client and chat agent",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test src/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "openai": "7.42.0",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
